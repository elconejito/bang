APP_NAME=Bang
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost
# Domain used for API routing (e.g. bang.test in local, api.yourdomain.com in production)
APP_API_DOMAIN=

# Set to true to allow new user registrations
REGISTRATION_ENABLED=false

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bang
DB_USERNAME=root
DB_PASSWORD=

# Legacy MySQL connection (for data migration only)
DB_LEGACY_HOST=127.0.0.1
DB_LEGACY_PORT=3306
DB_LEGACY_DATABASE=
DB_LEGACY_USERNAME=
DB_LEGACY_PASSWORD=
DB_LEGACY_SOCKET=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# JWT secret — generate with: php artisan jwt:secret
JWT_SECRET=
JWT_ALGO=

# Base URL for API requests from the frontend (Vite)
VITE_API_BASE_URL=/api

# Seed user credentials (used by database seeders)
TEST_EMAIL=
TEST_NAME=
TEST_PASSWORD=
